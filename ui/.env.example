# Better Auth (Agent Auth provider) — see docs/agent-auth.md
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
NEXT_PUBLIC_BETTER_AUTH_URL=http://localhost:3000

# SQLite path for agent/host/grant tables (local). Use :memory: for tests.
BETTER_AUTH_DB_PATH=./.data/better-auth.sqlite

# Registry HTTP base used by capability onExecute proxy
REGISTRY_URL=http://localhost:12121
NEXT_PUBLIC_API_URL=http://localhost:12121
NEXT_PUBLIC_GATEWAY_URL=http://localhost:21212
